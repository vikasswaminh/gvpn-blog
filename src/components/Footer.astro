---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="brand" href="/">
          <img src="/meshwg-blue-logo.svg" alt="" width="26" height="26" class="brand-logo-img" aria-hidden="true" style="flex-shrink: 0; margin-right: 6px;" />
          <span class="brand-name">{SITE.brand}</span>
        </a>
        <p class="footer-desc">
          Hosted WireGuard mesh + zero-trust access. Strict per-org isolation, fast-acting policies, works with the routers you already own.
        </p>
      </div>
      
      <div class="footer-links-grid">
        <div class="footer-col">
          <h4 class="footer-col-title">PRODUCT</h4>
          <a href="https://meshwg.com/docs/quickstart">Quickstart</a>
          <a href="https://meshwg.com/docs">Docs</a>
          <a href="https://meshwg.com/pricing">Pricing</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">ACCOUNT</h4>
          <a href="https://meshwg.com/login">Sign in ↗</a>
          <a href="https://meshwg.com/signup">Sign up free ↗</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">CONTACT</h4>
          <a href="#">Contact us</a>
          <a href="#">Talk to us (Pro)</a>
          <a href="mailto:hello@meshwg.com">hello@meshwg.com</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">COMPANY</h4>
          <a href="https://meshwg.com/careers">Careers</a>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <div class="fb-left">
        © {year} {SITE.brand}. All rights reserved.
      </div>
      <div class="fb-center">
        <a href="https://meshwg.com/privacy">Privacy</a> · <a href="https://meshwg.com/terms">Terms</a> · <a href="https://meshwg.com/refunds">Refund & Cancellation</a> · <a href="https://meshwg.com/security">Security</a>
      </div>
      <div class="fb-right">
        WireGuard is a registered trademark of Jason A. Donenfeld.
      </div>
    </div>
  </div>
</footer>
