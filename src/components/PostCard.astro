---
interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: string;
  pillText?: string;
  pillColor?: 'orange' | 'red' | 'purple';
  cover?: string;
}

const { url, title, description, pubDate, tags, minutes, pillText = 'engineering guide', pillColor = 'orange', cover } = Astro.props;
---

<a href={url} class="mag-card hover-card" data-tilt>
  {cover && (
    <div class="card-img-container">
      <img src={cover} alt={title} class="card-img" width="800" height="400" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card-content">
    <div class={`mag-pill pill-${pillColor}`}>{pillText}</div>
    <h3 class="card-t">{title}</h3>
    <p class="card-d">{description}</p>
    {minutes && (
      <div class="card-meta">
        <span>{minutes} min read</span>
        <span class="dot">·</span>
        <span class="read-link">Read article &rarr;</span>
      </div>
    )}
  </div>
</a>
