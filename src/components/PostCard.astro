---
import FormattedDate from './FormattedDate.astro';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: number;
}
const { url, title, description, pubDate, tags = [], minutes } = Astro.props;
---

<article class="post-card">
  <h2 class="post-card-title"><a href={url}>{title}</a></h2>
  <p class="post-card-meta">
    <FormattedDate date={pubDate} />
    {minutes ? <span aria-hidden="true">·</span> : null}
    {minutes ? <span>{minutes} min read</span> : null}
  </p>
  <p class="post-card-desc">{description}</p>
  {
    tags.length > 0 && (
      <p class="post-card-tags">
        {tags.map((t) => (
          <a class="tag" href={`/tags/${t}/`}>
            #{t}
          </a>
        ))}
      </p>
    )
  }
</article>
