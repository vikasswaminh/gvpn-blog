---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, readingTime } from '../utils/posts';

const allPosts = await getPublishedPosts();

// Helper to find a post by slug
const getPost = (slug: string) => allPosts.find(p => p.slug === slug);

const featured = getPost('wireguard-mesh-vpn-key-management-key-rotation-best-practices');

let optimizedFeaturedCover;
if (featured && featured.data.cover) {
  optimizedFeaturedCover = await getImage({
    src: featured.data.cover,
    width: 1200,
    height: 630,
    widths: [400, 600, 800, 1200],
    quality: 60,
    format: 'webp'
  });
}

const featuredDate = featured ? featured.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}) : null;

const hasFeaturedStrategy = featured?.data.tags?.some(tag => tag.toLowerCase() === 'strategy guide' || tag.toLowerCase() === 'protocol deep-dive');
const featuredPillText = hasFeaturedStrategy ? 'STRATEGY & ARCHITECTURE' : 'ENGINEERING GUIDE';
const featuredPillClass = hasFeaturedStrategy ? 'mag-pill pill-purple' : 'mag-pill pill-orange';

const gridSlugs = [
  'how-wireguard-mesh-control-plane-manages-keys-peers-routes',
  'wireguard-mesh-vpn-without-agent-existing-routers',
  'how-to-set-up-a-wireguard-mesh-vpn',
  'cloud-wireguard-vpn-meshwg',
  'how-to-build-a-multi-location-wireguard-network-with-routers',
  'how-to-set-up-a-router-vpn-without-installing-vpn-software',
  'managed-vs-self-hosted-wireguard-vpn-2026',
  'wireguard-site-to-site-vpn-multiple-locations',
  'wireguard-nat-traversal-behind-cgnat-2026',
  'manage-multiple-wireguard-tunnels-mesh-vpn-2026',
  'mesh-vpn-vs-ipsec-vs-sdwan-2026',
  'tp-link-site-to-site-vpn-wireguard-2026',
  'branch-office-vpn-smb-rollout-playbook-2026',
  'sd-wan-alternatives-2026',
  'wireguard-site-to-site-vpn-how-it-works-2026'
];
const gridPosts = gridSlugs.map(getPost).filter(Boolean);

// Dynamically distribute based on exact tags to prevent SEO keywords from breaking categorization
const strategyPosts = allPosts.filter(p => p.data.tags.some(tag => tag.toLowerCase() === 'strategy guide' || tag.toLowerCase() === 'protocol deep-dive'));

const engineeringPosts = allPosts.filter(p => !strategyPosts.includes(p));

const title = "MeshWG Engineering & Strategy Blog | WireGuard Mesh VPN";
const description = "The official MeshWG engineering and strategy blog. Expert technical guides and architectural blueprints for deploying enterprise WireGuard mesh networks.";
const seoKeywords = ["wireguard mesh vpn", "meshwg", "mesh vpn setup", "enterprise wireguard architecture", "zero trust network access"];
---

<BaseLayout title={title} description={description} seoKeywords={seoKeywords}>
  {optimizedFeaturedCover && (
    <link 
      slot="head"
      rel="preload" 
      as="image" 
      href={optimizedFeaturedCover.src} 
      imagesrcset={optimizedFeaturedCover.srcSet?.attribute || optimizedFeaturedCover.srcSet} 
      imagesizes="(max-width: 768px) 100vw, 600px" 
      fetchpriority="high"
    />
  )}
  <section class="mag-section">
    <div class="mag-wrap">
      
      <!-- LEFT SIDEBAR -->
      <aside class="mag-sidebar mag-left" aria-label="Strategy & Architecture articles">
        <div class="mag-pill pill-purple">STRATEGY & ARCHITECTURE</div>
        <ul class="mag-list">
           {strategyPosts.map(p => (
            <li>
              <a href={`/blog/${p.slug}/`} class="mag-list-link">{p.data.title}</a>
            </li>
          ))}
        </ul>
      </aside>

      <!-- CENTER MAIN -->
      <main class="mag-center">
        <div class="mag-header">
          <h1 class="mag-h1">MeshWG Engineering & Strategy Blog</h1>
          <p class="mag-desc">Expert articles on mesh networks, WireGuard, routing, & IT infrastructure</p>
        </div>

        <div class="mag-pill-row" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
          <div class="mag-pill pill-blue" style="background: #1F4FD8; color: white; display: flex; align-items: center; gap: 6px; margin-bottom: 0;"><span style="color: #f97316; font-size: 1.2em;">🔥</span> NEWEST ARTICLES</div>
          <span class="mag-subtext" style="color: var(--text-4); font-size: 14px; font-weight: 500;">Latest from our experts</span>
        </div>

        <!-- Featured Post -->
        {featured && (
          <a href={`/blog/${featured.slug}/`} class="mag-featured hover-card" data-tilt>
            <div class="feat-img">
              {featured.data.cover && <Image src={featured.data.cover} alt={featured.data.title} width={1200} height={630} widths={[400, 600, 800, 1200]} quality={60} sizes="(max-width: 768px) 100vw, 600px" loading="eager" fetchpriority="high" decoding="sync" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" />}
              <div class="mesh-bg" style="opacity: 0.2;"></div>
            </div>
            <div class="feat-content">
              <div class="mag-pill-row" style="border-bottom: 0; padding-bottom: 0; margin-bottom: 12px;">
                <div class={featuredPillClass}>{featuredPillText}</div>
                <div class="mag-pill pill-red">NEW</div>
              </div>
              <h2 class="feat-t">{featured.data.title}</h2>
              <p class="feat-d">{featured.data.description}</p>
              <div class="feat-meta">
                <span>{featuredDate}</span>
                <span class="dot">·</span>
                <span>{readingTime(featured.body)} min read</span>
                <span class="dot">·</span>
                <span class="read-link" aria-hidden="true">Read article &rarr;</span>
              </div>
            </div>
          </a>
        )}

        <!-- Grid Posts -->
        <div class="mag-grid">
          {gridPosts.map((p) => (
            <PostCard
              url={`/blog/${p.slug}/`}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              cover={p.data.cover}
              minutes={readingTime(p.body).toString()}
            />
          ))}
        </div>
      </main>

      <!-- RIGHT SIDEBAR -->
      <aside class="mag-sidebar mag-right" aria-label="Engineering Guides articles">
        <div class="mag-pill pill-orange">ENGINEERING GUIDES</div>
        <ul class="mag-list">
          {engineeringPosts.map(p => (
            <li>
              <a href={`/blog/${p.slug}/`} class="mag-list-link">{p.data.title}</a>
            </li>
          ))}
        </ul>
      </aside>

    </div>
  </section>
</BaseLayout>
